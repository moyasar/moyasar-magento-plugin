# Git Attributes configuration
# Exclude development files, Docker setup, and helper scripts when generating release zips (Composer / Packagist)

.gitattributes export-ignore
.gitignore export-ignore
docker-compose.yml export-ignore
docker-compose.override.yml export-ignore
.docker/ export-ignore
bin/ export-ignore
dev/ export-ignore
DEVELOPMENT.md export-ignore
.github/ export-ignore
.idea/ export-ignore
.vscode/ export-ignore
create_sample.php export-ignore
